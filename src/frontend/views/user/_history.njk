{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "components/createTagMacro.njk" import createTag %}
<h2 class="govuk-heading-l govuk-!-margin-top-8">History</h2>
{% if accountHistory and accountHistory.length %}
  {% for transaction in accountHistory %}

      {% set transactionRows = [
          { key: { text: "Component" },  value: { text: transaction.componentId } },
          { key: { text: "Reason" },     value: { text: transaction.interventionReason } },
          { key: { text: "Code" },       value: { text: transaction.interventionCode if transaction.interventionCode else "N/A" } },
          { key: { text: "Case or Risk Assessment ID" }, value: { text: transaction.originatorReferenceId if transaction.originatorReferenceId else "N/A" } },
          { key: { text: "Requester ID" }, value: { text: transaction.requesterId if transaction.requesterId else "N/A" } }
        ] %}

      {% if transaction.interventionEvents.length %}
        {% set eventRows = [] %}
        {% for event in transaction.interventionEvents %}
          {% if event.showState == true %}
            {% if event.interventionState == "ACTIVE" %}
              {% set stateColour = "red" %}
            {% elif event.interventionState == "MITIGATED" %}
              {% set stateColour = "green" %}
            {% elif event.interventionState == "REMOVED" %}
              {% set stateColour = "grey" %}
            {% elif event.interventionState == "SUPERSEDED" %}
              {% set stateColour = "orange" %}
            {% elif event.interventionState == "IGNORED" %}
              {% set stateColour = "yellow" %}
            {% else %}
              {% set stateColour = "blue" %}
            {% endif %}
            {% set eventRows = eventRows.concat([{
                key: { text: event.interventionName | replace("_", " ")},
                value: { html: '<strong class="govuk-tag govuk-tag--' + stateColour + '">' + event.displayState + '</strong>' }
            }]) %}
          {% endif %}
        {% endfor %}
      {% endif %}
      {% set combinedData = eventRows.concat(transactionRows) %}
      {% set cardTitleHtml %}
        {{ createTag(transaction, automatedSources, manualSources)}}
      {% endset %}

      {{ govukSummaryList({ classes: "govuk-!-margin-bottom-4 govuk-!-font-size-16", card: {
        title: {
          headingLevel: 3,
          classes: "govuk-fraud-summary-card__title govuk-grid-column-full govuk-!-padding-0 govuk-!-margin-0",
          html: cardTitleHtml
        }
        }, rows: combinedData }) }}

    {% endfor %}
    <h2 class="govuk-heading-m govuk-!-margin-top-7">Field descriptions</h2>
    {{ govukSummaryList({
      classes: "govuk-!-font-size-16",
      rows: [
        {
          key: {
            text: "Component"
          },
          value: {
            text: "The part of the DI system that has generated the event (e.g. TICF, Auth or Identity)."
          }
        },
        {
          key: {
            text: "Reason"
          },
          value: {
            text: "The reason for the intervention (e.g. coercion, account-takeover etc)."
          }
        },
        {
          key: {
            text: "Code"
          },
          value: {
            text: "The intervention code that has been applied to the account."
          }
        },
        {
          key: {
            text: "Case or Risk Assessment ID"
          },
          value: {
            text: "The unique ID of the case or risk assessment that led to the intervention."
          }
        },
        {
          key: {
            text: "Requester ID"
          },
          value: {
            text: "This unique ID can be used to identify the user who applied the intervention. Not populated for automated interventions."
          }
        }
      ]
    })}}
{% else %}
  <p class="govuk-body-s">No history available for this account.</p>
{% endif %}
