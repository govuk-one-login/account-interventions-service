  {% if not transaction.originatingComponent %}
    {% set tagDescription = "SOURCE UNKNOWN" %}
    {% set tagColour = "grey" %}
  {% elif transaction.originatingComponent in automatedSources %}
    {% set tagDescription = "AUTOMATED" %}
    {% set tagColour = "purple" %}
  {% elif transaction.originatingComponent in manualSources %}
    {% set tagDescription = "MANUAL" %}
    {% set tagColour = "teal" %}
  {% else %}
    {% set tagDescription = transaction.originatingComponent %}
    {% set tagColour = "grey" %}
  {% endif %}

  <span>{{ transaction.sentAtFormatted }}</span>
  <span>  <strong class="govuk-!-font-size-16 govuk-tag govuk-tag--{{ tagColour }}">{{ tagDescription }}</strong></span>
