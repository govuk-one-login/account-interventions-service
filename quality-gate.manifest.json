{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.16.0/schemas/schema.json",
  "services": [
    {
      "product": "Account-Intervention-Service",
      "component": "Account-Intervention-Service",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/acceptance-checks.yaml",
            "path": "$.jobs.acceptance-checks"
          },
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/acceptance-checks.yaml",
            "path": "$.jobs.acceptance-checks"
          },
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/acceptance-checks.yaml",
            "path": "$.jobs.acceptance-checks"
          },
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "code style and linting"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pact-test-api-provider.yaml",
            "path": "$.jobs.contract-testing"
          },
          "checks": [
            {
              "name": "contract"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pact-test-message-consumer.yaml",
            "path": "$.jobs.contract-testing"
          },
          "checks": [
            {
              "name": "contract"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/code-quality.yaml",
            "path": "$.jobs.run-pre-commit"
          },
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "code style and linting"
            }
          ]
        }
      ]
    }
  ]
}
